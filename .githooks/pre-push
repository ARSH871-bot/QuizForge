#!/bin/sh
# Blocks direct pushes to main.
#
# This is no longer the protection. A GitHub ruleset on `main` rejects direct
# pushes server-side and cannot be bypassed; see ADR 0009. This hook exists so
# the rejection arrives in one second locally instead of after a round trip,
# and so the error message explains what to do instead.
#
# Enable with: git config core.hooksPath .githooks

protected="refs/heads/main"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [ "$remote_ref" = "$protected" ]; then
        cat >&2 <<'MSG'

  Direct pushes to main are not allowed.

  Open a pull request instead:

    git switch -c feat/your-change
    git push -u origin feat/your-change
    gh pr create

  Bypassing this with --no-verify will not help: a ruleset on main rejects
  the push server-side as well. The only legitimate exception is a history
  rewrite, which cannot be expressed as a pull request.

MSG
        exit 1
    fi
done

exit 0
