#!/bin/sh
# Enforce Conventional Commits without requiring Node or any dependency.
# Enable with: git config core.hooksPath .githooks

msg_file="$1"
first_line=$(head -n1 "$msg_file")

# Allow merge, revert, and fixup commits through untouched.
case "$first_line" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9/-]+\))?!?: .{1,}$'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  cat >&2 <<'MSG'
✗ Commit message does not follow Conventional Commits.

  <type>(<optional scope>): <description>

  Types: feat fix docs style refactor perf test build ci chore revert

  Examples:
    feat(play): expire abandoned attempts after the tournament closes
    fix(billing): make stripe webhook handling idempotent
    docs: record the decision to drop mysql support

MSG
  printf '  You wrote: %s\n\n' "$first_line" >&2
  exit 1
fi

if [ ${#first_line} -gt 72 ]; then
  printf '✗ Subject line is %s characters; keep it to 72 or fewer.\n' "${#first_line}" >&2
  exit 1
fi

exit 0
