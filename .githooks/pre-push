#!/bin/sh
# Blocks direct pushes to main.
#
# This IS the protection. There is no server-side equivalent: the repository is
# private on the Free plan, where GitHub rulesets are unavailable, so nothing
# stops a direct push to `main` except this file. See ADR 0013.
#
# Which means it is advisory and easily bypassed - by `--no-verify`, and by any
# clone that has not run the command below. It catches accidents, not intent.
# Treat a green CI run as information rather than as a gate: nothing forces a
# pull request to pass before it merges.
#
# Enable with: git config core.hooksPath .githooks

protected="refs/heads/main"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [ "$remote_ref" = "$protected" ]; then
        cat >&2 <<'MSG'

  Direct pushes to main are not allowed.

  Open a pull request instead:

    git switch -c feat/your-change
    git push -u origin feat/your-change
    gh pr create

  --no-verify will bypass this, and nothing on the server will stop you -
  this hook is the only protection `main` has. Bypass it deliberately or not
  at all.

  The one routine exception is a history rewrite, which cannot be expressed
  as a pull request.

MSG
        exit 1
    fi
done

exit 0
