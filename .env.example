# Copy to .env and fill in. .env is gitignored and must never be committed.

# Database - the only setting actually required for local development
DATABASE_URL=jdbc:postgresql://localhost:5432/quizforge
DB_USERNAME=quizforge
DB_PASSWORD=local-dev-only

# Server
PORT=8080

# ---------------------------------------------------------------------------
# Email - OPTIONAL. Leave all of this alone.
#
# EMAIL_TEST_MODE defaults to true, which logs messages instead of sending
# them, so the application runs correctly with no mail configuration at all.
#
# A real provider (Resend) is wired in M4. Do not put a personal Gmail app
# password here: personal SMTP throttles at a few hundred messages a day, hurts
# deliverability, and ties transactional mail to a personal account.
# ---------------------------------------------------------------------------
# EMAIL_TEST_MODE=true
# MAIL_HOST=
# MAIL_USERNAME=
# MAIL_PASSWORD=
