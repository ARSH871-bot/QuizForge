{
  "name": "@quizforge/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript client for the QuizForge API. Not published; the package name is the owner's decision (see issue #83).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "generate": "openapi-typescript ../../openapi.yaml -o src/types.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
