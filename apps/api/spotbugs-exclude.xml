<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">

    <!--
      EI_EXPOSE_REP2 fires when a constructor stores a reference to an
      externally mutable object. That is a real defect for value objects
      holding arrays or Dates, and the detector stays enabled for those.

      It is a false positive for Spring constructor injection: storing the
      injected collaborator in a final field is the entire mechanism. The
      alternative the detector implies - defensively copying an injected
      singleton - is not possible and would be wrong if it were.

      Scoped to constructors of the Spring bean layers only, so entities and
      value objects elsewhere are still checked.
    -->
    <Match>
        <Class name="~com\.quizforge\..*\.(app|web|security)\..*"/>
        <Method name="&lt;init&gt;"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!--
      Payload records defensively copy their lists into an unmodifiable
      wrapper in a compact constructor, so the accessor cannot leak anything
      mutable. SpotBugs cannot see through Collections.unmodifiableList and
      reports the accessor regardless.

      This suppression is justified by a test, not by assertion:
      QuestionPayloadTest.payloadsAreImmutableAfterConstruction and
      ImportReportTest.isImmutableAfterConstruction each mutate the list passed
      to the constructor, assert the value is unchanged, then assert the
      accessor's list rejects modification. If that property is ever lost, a
      test fails - the suppression cannot hide it.
    -->
    <Match>
        <Class name="~com\.quizforge\.content\.(domain\.payload|importer)\..*"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

</FindBugsFilter>
