{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "security:openssf-scorecard"
  ],
  "timezone": "Pacific/Auckland",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "labels": ["type: dependencies"],
  "vulnerabilityAlerts": {
    "labels": ["type: security", "priority: high"],
    "schedule": ["at any time"],
    "prPriority": 10
  },
  "packageRules": [
    {
      "description": "Group all Spring Boot and Spring Framework updates together — they are released in lockstep and splitting them creates unbuildable intermediate states.",
      "matchPackagePatterns": ["^org.springframework"],
      "groupName": "spring",
      "semanticCommitScope": "spring"
    },
    {
      "description": "Group test-only tooling; low risk, high noise.",
      "matchPackagePatterns": [
        "^org.testcontainers",
        "^com.tngtech.archunit",
        "^org.junit",
        "^org.assertj",
        "^org.mockito"
      ],
      "groupName": "test tooling",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Auto-merge patch updates once CI is green. Minor and major always need a human.",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Never silently bump the Java release target.",
      "matchPackageNames": ["java", "eclipse-temurin"],
      "automerge": false,
      "labels": ["type: dependencies", "needs: decision"]
    }
  ],
  "postUpdateOptions": ["pnpmDedupe"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  }
}
